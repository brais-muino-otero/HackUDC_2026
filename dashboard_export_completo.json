        "uid": "${ds_infinity}"
      },
      "description": "Veredicto binario para el concello seleccionado: indica si en este momento es apto (✅) o no apto (❌) para practicar deporte al aire libre. El resultado se obtiene aplicando los umbrales de temperatura, precipitación y viento sobre los datos meteorológicos actuales; basta con que un factor supere su límite para que el concello se marque como no apto.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "❌  No Apto"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "✅  ¡Apto!"
                }
              },
              "type": "value"
            }
